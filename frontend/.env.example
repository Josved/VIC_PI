# URL directa del backend para Expo Go en un teléfono de la misma red.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
VIC_ALLOW_INSECURE_HTTP=true

# Usar claves separadas y restringidas para cada plataforma.
GOOGLE_MAPS_ANDROID_API_KEY=reemplazar-con-clave-android
GOOGLE_MAPS_IOS_API_KEY=reemplazar-con-clave-ios

# Datos de la cuenta gratuita de Expo; se obtienen con `eas init`.
EXPO_OWNER=reemplazar-con-usuario-expo
EAS_PROJECT_ID=reemplazar-con-project-id

# Archivo Android descargado de Firebase. Nunca debe subirse a Git.
GOOGLE_SERVICES_JSON=./google-services.json
