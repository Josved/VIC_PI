{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(vic_solicitudes_http_total[5m]))", "legendFormat": "solicitudes/s", "refId": "A"}],
      "title": "Solicitudes de la API",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(vic_duracion_solicitudes_http_segundos_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A"}],
      "title": "Latencia p95 de la API",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "up{job=~\"vic-api-.*\"}", "legendFormat": "{{job}}", "refId": "A"}],
      "title": "Réplicas de API disponibles",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "CPU", "refId": "A"}],
      "title": "Uso de CPU del servidor privado",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"color": "red", "text": "INACTIVO"}, "1": {"color": "green", "text": "ACTIVO"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      },
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "vic_firewall_activo", "legendFormat": "{{servidor}}", "refId": "A"}],
      "title": "Estado de los firewalls UFW",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 16},
      "id": 6,
      "targets": [{"expr": "vic_firewall_bloqueos_ventana", "legendFormat": "{{servidor}}", "refId": "A"}],
      "title": "Bloqueos UFW (últimos 5 minutos)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 16},
      "id": 7,
      "targets": [{"expr": "vic_firewall_reglas_activas", "legendFormat": "{{servidor}}", "refId": "A"}],
      "title": "Reglas activas de UFW",
      "type": "stat"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["VIC", "rubrica"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "VIC - Estado general",
  "uid": "vic-general",
  "version": 2
}
